# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env template IS committed
!.env.example

# Roobert is a commercially licensed typeface (Displaay Type Foundry) and must not be
# redistributed in a public repository. Drop the three variable TTFs into
# public/fonts/roobert/ locally (see README "Fonts") — the UI falls back to the
# committed Inter Tight (OFL) when they're absent.
public/fonts/roobert/
design/prototype/**/fonts/Roobert*.ttf

# local e2e scratch
.e2e-tmp.mjs
