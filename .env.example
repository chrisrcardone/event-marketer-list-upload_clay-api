# ══════════════════════════════════════════════════════════════════════
# Event Lead Router — environment template
# Copy to .env.local for local dev; set the same keys in Vercel for deploys.
# Every value here is required unless marked optional. Nothing in this file
# is a real credential.
# ══════════════════════════════════════════════════════════════════════

# ── Clay ────────────────────────────────────────────────────────────────
# Server-side only. Never referenced from client code, never logged, never
# returned in an error. Generate in Clay: Settings → API keys.
CLAY_API_KEY=

# The Clay Routine that enriches one lead and writes it to the Salesforce
# campaign. Format: function:t_...  (see docs/routine-contract.md, Phase 6)
CLAY_ROUTINE_ID=

# Optional. Shared secret for the Clay webhook route
# (/api/webhooks/clay). Leave empty to run polling-only — webhooks are a
# latency optimization, never a requirement.
CLAY_WEBHOOK_SECRET=

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL and keys: Supabase dashboard → Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The anon (publishable) key — safe for the browser; all client access is
# constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role key — SERVER ONLY. Bypasses RLS; used by route handlers,
# webhook processing, and cron reconciliation. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth / access control ───────────────────────────────────────────────
# Comma-separated list of email domains allowed to sign in, matched exactly
# against the substring after the final @ (lowercased). Empty or unset means
# NOBODY can sign in — the app fails closed and surfaces a setup error.
#   Example: clay.com
#   Example: clay.com,claylabs.com
ALLOWED_EMAIL_DOMAINS=

# ── Vercel Cron ─────────────────────────────────────────────────────────
# Bearer secret protecting /api/cron/* (cron requests carry no session).
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Tuning (all optional — sane defaults in code) ───────────────────────
# Max chunks in flight against Clay at once. Clay publishes no rate limits;
# 5 is a guess to tune against observed 429s.
MAX_CONCURRENT_CHUNKS=5

# Files with more effective rows than this run as one Clay batch instead of
# chunked inline runs. Lowering it degrades the app toward pure batch mode —
# a config change, not a rewrite.
MAX_INLINE_TOTAL_ROWS=5000

# Hard per-file row ceiling (the "split the file" screen). Clay's batch API
# caps at 50,000 items.
MAX_TOTAL_ROWS=50000

# ── Dev conveniences (optional) ─────────────────────────────────────────
# Set true to expose /dev/components (the component gallery) in a
# production build. It is always available in dev and always noindexed.
NEXT_PUBLIC_ENABLE_DEV_GALLERY=
